POST {{hostname}}/subscriptions/filter
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
	"filter": {
		"externalId": ["plant_a_*"],
		"timeseries": [{"id": 29}, {"externalId": "heater_2012_temp"}]
	},
	"limit": 500,
	"sort": { "property": ["name"], "order": "asc" }
}
