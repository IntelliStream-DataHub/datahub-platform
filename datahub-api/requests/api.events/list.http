###
POST {{hostname}}/events/list
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"filter": {
		"type": "zfs-event"
	},
	"advancedFilter": {
        "not": {
			"equals": {
				"property": ["subType"],
				"value": "sysevent.fs.zfs.history_event"
			}
        }
    }
}

###
POST {{hostname}}/events/list
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"filter": {
		"type": "zfs-event"
	},
	"advancedFilter": {
		"and": [
			{
                "equals": {
				    "property": ["subType"],
				    "value": "sysevent.fs.zfs.scrub_start"
			    }
            },
			{
                "equals": {
				    "property": ["subType"],
				    "value": "sysevent.fs.zfs.config_sync"
			    }
            }
		]
	}
}

