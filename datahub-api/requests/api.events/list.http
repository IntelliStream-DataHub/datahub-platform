###
POST {{hostname}}/events/list
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"filter": {
		"type": "zfs-event"
	},
	"advancedFilter": {
		"and": [
            {
                "in": {
                    "property": ["subType"],
                    "values": ["sysevent.fs.zfs.scrub_start", "sysevent.fs.zfs.config_sync"]
                }
            }
		]
	}
}

