		{
			"externalId": "example-org-invoice-api-requests",
			"name": "Example Org Invoice Api Requests",
			"parentExternalId": "example-org-invoice-data"
		}
	]
}

###
POST {{hostname}}/datasets/create
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
        {
          "connectedDataSets": [
            1088
          ],
          "name": "SAP SAFETY",
          "externalId": "sap_safety",
          "description": "",
          "writeProtected": true,
          "deactivated": false,
          "policies": ["policy_is_write_protected"]
        }
]}

