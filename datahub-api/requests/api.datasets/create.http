POST {{hostname}}/datasets/create
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"items": [
		{
			"externalId": "power-data-nordpool",
			"name": "Power Data From Nordpool",
			"description": "Data Set which contains power data from Nordpool",
			"writeProtected": false
		},
		{
			"externalId": "sensor-data",
			"name": "Sensor Data",
			"description": "Air quality data from room sensor devices",
			"writeProtected": false
		},
		{
			"externalId": "power-data-network-switch",
			"name": "Power Data Network Switch"
		}
	]
}

