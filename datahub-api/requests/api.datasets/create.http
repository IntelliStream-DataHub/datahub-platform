POST {{hostname}}/datasets/create
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"items": [
		{
			"externalId": "example-org-data",
			"name": "Example Org data"
		},
		{
			"externalId": "example-org-server-data",
			"name": "Example Org Server Data",
            "parentExternalId": "example-org-data"
		},
		{
			"externalId": "example-org-invoice-data",
			"name": "Example Org Invoice Data",
			"parentExternalId": "example-org-data"
