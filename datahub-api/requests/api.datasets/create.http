POST {{hostname}}/datasets/create
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"items": [
		{
			"externalId": "example_site_rack5",
			"name": "Example Site Rack 5",
			"description": "Data Set which contains data from equipment in rack 5",
			"metadata": {
				"property1": "foobar",
				"property2": "barfoo"
			},
			"policies": [
              "policy_is_read_protected",
              "policy_is_write_protected"
            ]
		}
	]
}


