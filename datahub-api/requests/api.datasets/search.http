POST {{hostname}}/datasets/search
Authorization: Bearer {{token}}
Content-Type: application/json

{
	"search": {
		"query": "power"
	},
    "filter": {
        "createdTime": {
            "isoMin": "2024-03-01T13:00:00.000Z"
        },
        "deactivated": false,
        "writeProtected": false
    }
}
