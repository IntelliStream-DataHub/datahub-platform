# /etc/systemd/system/datahub@.service
#
# One template for every DataHub Spring Boot service. The instance name is the short
# module name, and it drives every path:
#
#   systemctl enable --now datahub@api          /opt/datahub/api/app.jar
#   systemctl enable --now datahub@console      /etc/datahub/console.env, /etc/datahub/console/
#   datahub@stateless-consumer, datahub@stateful-consumer, datahub@analysis, datahub@cleanup
#
# Host-specific placement (which NUMA node, memory ceiling, extra writable mounts) lives
# in a drop-in per instance, datahub@<name>.service.d/placement.conf, so this file is the
# same on every host. JVM flags come from /etc/datahub/<name>.env (JAVA_OPTS); Spring
# Boot tuning from /etc/datahub/<name>/application.yml, layered on top of the jar's own
# configuration through SPRING_CONFIG_ADDITIONAL_LOCATION. Secrets stay in Vault.

[Unit]
Description=DataHub %i
Documentation=file:/opt/datahub/README.md
# The apps open a Postgres connection per request through a pgbouncer on localhost
# (StatelessRoutingDataSource has no app-side pool). Start after it when it exists.
After=network-online.target pgbouncer.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=datahub
Group=datahub
WorkingDirectory=/opt/datahub/%i

# Shared settings first, instance settings second (later files win).
EnvironmentFile=/etc/datahub/common.env
EnvironmentFile=/etc/datahub/%i.env
Environment=SPRING_CONFIG_ADDITIONAL_LOCATION=file:/etc/datahub/%i/
Environment=JAVA_HOME=/usr/lib/jvm/java

# $JAVA_OPTS is split on whitespace by systemd, so the env file can hold the whole
# flag list. /usr/bin/java is the alternatives link the Temurin and OpenJDK packages
# install; point at a tarball JDK here instead if you use one.
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/datahub/%i/app.jar

# Spring Boot exits 143 on SIGTERM; that is a clean stop, not a failure.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s
# Start: AlwaysPreTouch of a 20 GB heap plus the api's per-tenant Flyway pass.
# Stop: server.shutdown=graceful gives in-flight requests 60 s (see config/), then the
# JVM exits; SIGKILL only after that.
TimeoutStartSec=300s
TimeoutStopSec=90s
KillMode=mixed
KillSignal=SIGTERM

# /var/lib/datahub/<name> (JFR repository, SDK spool, a heap dump if one is ever taken on
# purpose) and /var/log/datahub/<name> (GC log, crash log), created and owned by the
# service user, and writable even under ProtectSystem=strict.
StateDirectory=datahub/%i
LogsDirectory=datahub/%i
StateDirectoryMode=0750
LogsDirectoryMode=0750

# Tomcat is allowed 20000 concurrent connections (config/); add Pulsar, ClickHouse,
# Postgres, file handles and the JVM's own use. Threads are few (virtual threads), but
# G1, Netty and the Pulsar client still create real ones.
LimitNOFILE=524288
TasksMax=16384
# A memory hog elsewhere should die before the service does.
OOMScoreAdjust=-500
# No core dumps, for the same reason the JVM flags take no heap dump: a core is a copy of
# process memory, credentials and tenant data included. systemd-coredump honours this
# limit too. A crash still leaves hs_err_<pid>.log (ErrorFile in the env file) and the
# JFR repository; see "Diagnostics" in the README.
LimitCORE=0

# Hardening. MemoryDenyWriteExecute must stay OFF: the JIT needs writable, executable
# pages. No SystemCallFilter either, the JVM's syscall surface is wide and a missing
# call fails in odd places; the rest below is safe for a JVM.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
