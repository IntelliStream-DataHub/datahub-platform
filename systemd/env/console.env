# /etc/datahub/console.env
#
# Instance-specific settings for datahub@console. JVM sized for one NUMA node of a
# dual-socket host, pinned there by the placement drop-in. Java 25 flags; every one below is a product flag, no experimental unlock.
#
# The console is a thin Thymeleaf UI with its session in Valkey; 16 GB is the low end of
# the per-service budget and still far more than it needs, which keeps GC rare.
#
# Read it as one line: systemd joins the backslash-continued lines and splits $JAVA_OPTS
# on whitespace in ExecStart.
JAVA_OPTS=-Xms16g -Xmx16g \
 -XX:+AlwaysPreTouch \
 -XX:+UseTransparentHugePages \
 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
 -XX:+UseCompactObjectHeaders \
 -XX:MaxDirectMemorySize=2g \
 -XX:MaxMetaspaceSize=512m \
 -XX:ReservedCodeCacheSize=256m \
 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/lib/datahub/console \
 -XX:+ExitOnOutOfMemoryError \
 -Xlog:gc*,safepoint:file=/var/log/datahub/console/gc.log:time,uptime,level,tags:filecount=10,filesize=64m
