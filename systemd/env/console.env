# /etc/datahub/console.env
#
# JVM flags for datahub@console: a fixed heap, pre-touched on the NUMA node the placement
# drop-in binds it to. A thin UI with its session in Valkey; far more than it needs.
# No heap dump on OOM (the JVM default); see "Diagnostics" in the README.
JAVA_OPTS=-Xms16g -Xmx16g -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -XX:+UseCompactObjectHeaders -XX:+ExitOnOutOfMemoryError
