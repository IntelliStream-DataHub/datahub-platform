# /etc/datahub/common.env   (root:root 0600: it carries the Vault AppRole secret)
#
# Settings shared by every datahub@<name> instance on this host. Per-instance values,
# above all JAVA_OPTS, live in /etc/datahub/<name>.env, which systemd reads second.

SPRING_PROFILES_ACTIVE=prod

# Vault AppRole the apps authenticate with (binds vault.address / vault.role-id /
# vault.secret-id). Everything else, database and Pulsar credentials, tenant config,
# file-storage roots, is read from Vault at start.
VAULT_ADDRESS=https://vault.internal.example.org:8200
VAULT_ROLE_ID=changeme
VAULT_SECRET_ID=changeme

# Pulsar. TLS in production; the broker CA is in the system trust store or given here.
PULSAR_SERVICE_URL=pulsar+ssl://pulsar.internal.example.org:6651
PULSAR_SERVICE_HTTPURL=https://pulsar.internal.example.org:8443
DATAHUB_PULSAR_TLS_ENABLED=true

# Address selection. Tomcat binds the wildcard address, so every service listens on both
# families without configuration. For OUTBOUND connections (Pulsar, ClickHouse, Neo4j,
# Valkey, pgbouncer) the JVM prefers IPv4 when a name has both records. "system" makes it
# follow the host's RFC 6724 policy (/etc/gai.conf) like every other process instead.
# Commented out because it needs every backing service listening on the family the host
# then picks first (for pgbouncer on localhost: ::1 as well as 127.0.0.1); enable once
# that is true everywhere.
#JAVA_TOOL_OPTIONS=-Djava.net.preferIPv6Addresses=system

# glibc creates one malloc arena per thread up to 8 x cores, and each arena holds on to
# freed memory. The JVM's native allocations (Netty, ZSTD/LZ4, JIT) do not need that;
# four arenas keep RSS predictable without measurable contention.
MALLOC_ARENA_MAX=4
