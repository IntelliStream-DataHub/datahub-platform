# /etc/datahub/stateful-consumer.env
#
# Instance-specific settings for datahub@stateful-consumer. JVM sized for one NUMA node of a
# dual-socket host, pinned there by the placement drop-in. Java 25 flags; every one below is a product flag, no experimental unlock.
#
# Applies resource mutations to Neo4j in order, one Failover consumer; memory-light,
# sized like the console.
#
# No heap dump on OOM (it would hold credentials and tenant data); JFR, the GC log and
# NMT are the standing diagnostics. See "Diagnostics" in the README.
#
# Read it as one line: systemd joins the backslash-continued lines and splits $JAVA_OPTS
# on whitespace in ExecStart.
JAVA_OPTS=-Xms16g -Xmx16g \
 -XX:+AlwaysPreTouch \
 -XX:+UseTransparentHugePages \
 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
 -XX:+UseCompactObjectHeaders \
 -XX:MaxDirectMemorySize=2g \
 -XX:MaxMetaspaceSize=512m \
 -XX:ReservedCodeCacheSize=256m \
 -XX:-HeapDumpOnOutOfMemoryError -XX:+ExitOnOutOfMemoryError \
 -XX:ErrorFile=/var/log/datahub/stateful-consumer/hs_err_%p.log \
 -XX:NativeMemoryTracking=summary \
 -XX:FlightRecorderOptions=repository=/var/lib/datahub/stateful-consumer/jfr \
 -XX:StartFlightRecording=name=datahub,disk=true,maxage=24h,maxsize=1g,memory-leaks=stack-traces,jdk.InitialEnvironmentVariable#enabled=false,jdk.InitialSystemProperty#enabled=false,jdk.SystemProcess#enabled=false \
 -Xlog:gc*,safepoint:file=/var/log/datahub/stateful-consumer/gc.log:time,uptime,level,tags:filecount=10,filesize=64m
