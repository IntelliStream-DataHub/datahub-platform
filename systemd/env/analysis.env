# /etc/datahub/analysis.env
#
# JVM flags for datahub@analysis: a fixed heap, pre-touched on the NUMA node the placement
# drop-in binds it to. CPU-bound; the heap holds the series matrices.
# No heap dump on OOM (the JVM default); the JFR recording, GC log and native memory
# tracking are the standing diagnostics, see "Diagnostics" in the README.
# systemd joins the backslash-continued lines.
JAVA_OPTS=-Xms16g -Xmx16g -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -XX:+UseCompactObjectHeaders \
 -XX:+ExitOnOutOfMemoryError \
 -XX:NativeMemoryTracking=summary \
 -XX:StartFlightRecording=name=datahub,disk=true,maxage=24h,maxsize=1g,memory-leaks=stack-traces,jdk.InitialEnvironmentVariable#enabled=false \
 -XX:FlightRecorderOptions=repository=/var/lib/datahub/analysis/jfr \
 -Xlog:gc*:file=/var/log/datahub/analysis/gc.log:time,uptime:filecount=10,filesize=64m
