# /etc/datahub/analysis.env
#
# Instance-specific settings for datahub@analysis. JVM sized for one NUMA node of a
# dual-socket host, pinned there by the placement drop-in. Java 25 flags; every one below is a product flag, no experimental unlock.
#
# CPU-bound (commons-math cross-correlation, cointegration, Welch coherence) on the
# series it fetches from the api. Stateless, no Pulsar, so little direct memory; the
# heap holds the series matrices. Benefits most from having a whole socket to itself.
#
# Read it as one line: systemd joins the backslash-continued lines and splits $JAVA_OPTS
# on whitespace in ExecStart.
JAVA_OPTS=-Xms16g -Xmx16g \
 -XX:+AlwaysPreTouch \
 -XX:+UseTransparentHugePages \
 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
 -XX:+UseCompactObjectHeaders \
 -XX:MaxDirectMemorySize=1g \
 -XX:MaxMetaspaceSize=512m \
 -XX:ReservedCodeCacheSize=256m \
 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/lib/datahub/analysis \
 -XX:+ExitOnOutOfMemoryError \
 -Xlog:gc*,safepoint:file=/var/log/datahub/analysis/gc.log:time,uptime,level,tags:filecount=10,filesize=64m
