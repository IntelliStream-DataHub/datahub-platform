# /etc/datahub/flow.env
#
# JVM flags for datahub@flow (intellistream-flow): a fixed heap, pre-touched on the NUMA node the
# placement drop-in binds it to.
#
# Runs hold their data on the heap, so it is sized for them: the run memory budget is half of it
# (datahub.flow.runs.memory-budget in /etc/datahub/flow/application.yml, unset by default).
# No heap dump on OOM (the JVM default); see "Diagnostics" in the README.
JAVA_OPTS=-Xms16g -Xmx16g -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -XX:+UseCompactObjectHeaders -XX:+ExitOnOutOfMemoryError
