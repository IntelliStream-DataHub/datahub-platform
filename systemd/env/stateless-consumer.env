# /etc/datahub/stateless-consumer.env
#
# JVM flags for datahub@stateless-consumer: a fixed heap, pre-touched on the NUMA node the
# placement drop-in binds it to. The heap holds the in-flight ClickHouse batches.
# No heap dump on OOM (the JVM default); see "Diagnostics" in the README.
# systemd joins the backslash-continued lines.
JAVA_OPTS=-Xms20g -Xmx20g -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -XX:+UseCompactObjectHeaders \
 -XX:+ExitOnOutOfMemoryError \
 -Xlog:gc*:file=/var/log/datahub/stateless-consumer/gc.log:time,uptime:filecount=10,filesize=64m
