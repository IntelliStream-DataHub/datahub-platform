# /etc/datahub/stateless-consumer.env
#
# Instance-specific settings for datahub@stateless-consumer. JVM sized for one NUMA node of a
# dual-socket host, pinned there by the placement drop-in. Java 25 flags; every one below is a product flag, no experimental unlock.
#
# Batches datapoints and events into ClickHouse inserts: the heap holds the in-flight
# batches, direct memory the Pulsar consumer buffers and ClickHouse request bodies.
#
# Read it as one line: systemd joins the backslash-continued lines and splits $JAVA_OPTS
# on whitespace in ExecStart.
JAVA_OPTS=-Xms20g -Xmx20g \
 -XX:+AlwaysPreTouch \
 -XX:+UseTransparentHugePages \
 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
 -XX:+UseCompactObjectHeaders \
 -XX:MaxDirectMemorySize=4g \
 -XX:MaxMetaspaceSize=512m \
 -XX:ReservedCodeCacheSize=256m \
 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/lib/datahub/stateless-consumer \
 -XX:+ExitOnOutOfMemoryError \
 -Xlog:gc*,safepoint:file=/var/log/datahub/stateless-consumer/gc.log:time,uptime,level,tags:filecount=10,filesize=64m
