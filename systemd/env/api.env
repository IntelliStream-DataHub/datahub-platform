# /etc/datahub/api.env
#
# Instance-specific settings for datahub@api. JVM sized for one NUMA node of a
# dual-socket host, pinned there by the placement drop-in. Java 25 flags; every one below is a product flag, no experimental unlock.
#
# Heap: 20 GB, fixed (Xms = Xmx) so G1 never has to grow it under load and the pre-touch
# faults every page in at start, on the bound node, instead of in the request path.
# Direct memory: Pulsar producers, Netty and the ClickHouse client allocate off-heap;
# 4 GB is generous for the api. Compact object headers (JEP 519) shave 4 bytes off
# every object, which on a JSON-heavy service is 5-10 % less heap traffic for free.
#
# NEVER add -XX:TieredStopAtLevel=1 here. It keeps the C2 compiler off, and with it the
# SHA-256 intrinsic the upload checksum depends on; uploads drop to a fraction of disk
# speed. Only ever use it for fast-start dev runs.
#
# No heap dump on OOM (it would hold credentials and tenant data); JFR, the GC log and
# NMT are the standing diagnostics. See "Diagnostics" in the README.
#
# Read it as one line: systemd joins the backslash-continued lines and splits $JAVA_OPTS
# on whitespace in ExecStart.
JAVA_OPTS=-Xms20g -Xmx20g \
 -XX:+AlwaysPreTouch \
 -XX:+UseTransparentHugePages \
 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
 -XX:+UseCompactObjectHeaders \
 -XX:MaxDirectMemorySize=4g \
 -XX:MaxMetaspaceSize=512m \
 -XX:ReservedCodeCacheSize=256m \
 -XX:-HeapDumpOnOutOfMemoryError -XX:+ExitOnOutOfMemoryError \
 -XX:ErrorFile=/var/log/datahub/api/hs_err_%p.log \
 -XX:NativeMemoryTracking=summary \
 -XX:FlightRecorderOptions=repository=/var/lib/datahub/api/jfr \
 -XX:StartFlightRecording=name=datahub,disk=true,maxage=24h,maxsize=1g,memory-leaks=stack-traces,jdk.InitialEnvironmentVariable#enabled=false,jdk.InitialSystemProperty#enabled=false,jdk.SystemProcess#enabled=false \
 -Xlog:gc*,safepoint:file=/var/log/datahub/api/gc.log:time,uptime,level,tags:filecount=10,filesize=64m
