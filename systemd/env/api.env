# /etc/datahub/api.env
#
# JVM flags for datahub@api: a fixed heap, pre-touched on the NUMA node the placement drop-in
# binds it to. Never add -XX:TieredStopAtLevel=1: it disables C2 and with it the SHA-256
# intrinsic the upload checksum depends on.
# No heap dump on OOM (the JVM default); the JFR recording, GC log and native memory
# tracking are the standing diagnostics, see "Diagnostics" in the README.
# systemd joins the backslash-continued lines.
JAVA_OPTS=-Xms20g -Xmx20g -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -XX:+UseCompactObjectHeaders \
 -XX:+ExitOnOutOfMemoryError \
 -XX:NativeMemoryTracking=summary \
 -XX:StartFlightRecording=name=datahub,disk=true,maxage=24h,maxsize=1g,memory-leaks=stack-traces,jdk.InitialEnvironmentVariable#enabled=false \
 -XX:FlightRecorderOptions=repository=/var/lib/datahub/api/jfr \
 -Xlog:gc*:file=/var/log/datahub/api/gc.log:time,uptime:filecount=10,filesize=64m
