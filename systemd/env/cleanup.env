# /etc/datahub/cleanup.env
#
# Instance-specific settings for datahub@cleanup. JVM sized for one NUMA node of a
# dual-socket host, pinned there by the placement drop-in. Java 25 flags; every one below is a product flag, no experimental unlock.
#
# Scheduled housekeeping, single instance, nothing hot: the one service that does not
# need the 16-20 GB budget. It shares a node with a heavier service.
#
# Diagnostics: no heap dump on OutOfMemoryError. A dump is a copy of the heap, credentials
# and tenant data included, so it is taken deliberately (jcmd GC.heap_dump) when a leak
# cannot be found any other way; see "Diagnostics" in the README. Standing in for it: a
# continuous JFR recording with leak candidates (bounded on disk, with the events that
# would record this environment and other processes' command lines turned off), the GC
# log, native memory tracking, and a crash log under /var/log.
#
# Read it as one line: systemd joins the backslash-continued lines and splits $JAVA_OPTS
# on whitespace in ExecStart.
JAVA_OPTS=-Xms4g -Xmx4g \
 -XX:+AlwaysPreTouch \
 -XX:+UseTransparentHugePages \
 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
 -XX:+UseCompactObjectHeaders \
 -XX:MaxDirectMemorySize=512m \
 -XX:MaxMetaspaceSize=512m \
 -XX:ReservedCodeCacheSize=256m \
 -XX:-HeapDumpOnOutOfMemoryError -XX:+ExitOnOutOfMemoryError \
 -XX:ErrorFile=/var/log/datahub/cleanup/hs_err_%p.log \
 -XX:NativeMemoryTracking=summary \
 -XX:FlightRecorderOptions=repository=/var/lib/datahub/cleanup/jfr \
 -XX:StartFlightRecording=name=datahub,disk=true,maxage=24h,maxsize=1g,memory-leaks=stack-traces,jdk.InitialEnvironmentVariable#enabled=false,jdk.InitialSystemProperty#enabled=false,jdk.SystemProcess#enabled=false \
 -Xlog:gc*,safepoint:file=/var/log/datahub/cleanup/gc.log:time,uptime,level,tags:filecount=10,filesize=64m
