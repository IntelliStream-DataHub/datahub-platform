# /etc/datahub/cleanup.env
#
# JVM flags for datahub@cleanup: a fixed heap, pre-touched on the NUMA node the placement
# drop-in binds it to. Scheduled housekeeping, nothing hot.
# No heap dump on OOM (the JVM default); see "Diagnostics" in the README.
# systemd joins the backslash-continued lines.
JAVA_OPTS=-Xms4g -Xmx4g -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages -XX:+UseCompactObjectHeaders \
 -XX:+ExitOnOutOfMemoryError \
 -Xlog:gc*:file=/var/log/datahub/cleanup/gc.log:time,uptime:filecount=10,filesize=64m
